# Número do WhatsApp no formato internacional, só dígitos (55 + DDD + número).
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# Opcional: chave da Google Maps Embed API. Sem ela, a seção "Onde estamos"
# mostra um cartão com link para o Google Maps em vez do mapa embutido.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Endereço usado nos links de mapa e rota.
NEXT_PUBLIC_ENDERECO_LOJA=Água Chata, Itaquaquecetuba - SP
